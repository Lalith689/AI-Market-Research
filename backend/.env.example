# Application Configuration
APP_NAME="MarketLens API"
APP_ENV="development"
PORT=8000
HOST="127.0.0.1"

# LLM Provider Configuration: 'openai', 'gemini', or 'mock'
# If set to 'mock', the platform generates rich simulated reports without calling external APIs (great for local demoing & free testing)
LLM_PROVIDER="mock"

# API Keys (Provide your own when running with real LLMs)
OPENAI_API_KEY=""
GEMINI_API_KEY=""

# Database
DATABASE_URL="sqlite:///./marketlens.sqlite3"

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"
